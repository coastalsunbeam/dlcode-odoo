<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dlcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dlcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="DLCode" name="dlcode_gs1_qr" groups="base.group_system">
                    <block title="DLCode GS1 QR codes" name="dlcode_settings">
                        <setting string="API key" help="Create a key at dlcode.org under Settings, API keys.">
                            <field name="dlcode_api_key" password="True" placeholder="dlc_live_..."/>
                        </setting>
                        <setting help="Send a product to DLCode each time its barcode changes.">
                            <field name="dlcode_auto_sync"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
