<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_dlcode" model="ir.ui.view">
        <field name="name">product.template.form.dlcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="DLCode" name="dlcode">
                    <field name="is_product_variant" invisible="1"/>
                    <field name="product_variant_count" invisible="1"/>
                    <p invisible="is_product_variant or product_variant_count &lt;= 1">This product has variants. Open a variant to see its DLCode QR code.</p>
                    <group invisible="not is_product_variant and product_variant_count &gt; 1">
                        <field name="dlcode_code_url" widget="url"/>
                        <field name="dlcode_synced_at"/>
                    </group>
                    <button name="action_dlcode_sync" type="object" string="Sync to DLCode" class="btn-primary"/>
                    <field name="dlcode_qr_svg" widget="image" invisible="(not is_product_variant and product_variant_count &gt; 1) or not dlcode_qr_svg" nolabel="1" options="{'size': [0, 320]}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
