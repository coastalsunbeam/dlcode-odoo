<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_dlcode_recall" model="ir.ui.view">
        <field name="name">stock.lot.form.dlcode.recall</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="DLCode recall" name="dlcode_recall">
                    <field name="dlcode_recalled"/>
                    <field name="dlcode_recall_note" placeholder="Do not eat. Return it to the store for a full refund."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
